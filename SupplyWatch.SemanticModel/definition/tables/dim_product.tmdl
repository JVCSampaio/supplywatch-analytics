/// Material industrial fictício do cadastro de produtos.
table dim_product
	column product_id
		dataType: string
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: product_id
	column Produto
		dataType: string
		summarizeBy: none
		sourceColumn: product_name
	column Categoria
		dataType: string
		summarizeBy: none
		sourceColumn: category
	partition dim_product = m
		mode: import
		source =
			let
			    Nome = "dim_product.csv",
			    Ler = (pasta as text) as table =>
			        let
			            Bruto = Csv.Document(File.Contents(pasta & "/" & Nome), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			            Cabecalho = Table.PromoteHeaders(Bruto, [PromoteAllScalars=true]),
			            Nulos = Table.ReplaceValue(Cabecalho, "", null, Replacer.ReplaceValue, Table.ColumnNames(Cabecalho))
			        in
			            Nulos,
			    Fonte = try Ler(DataFolder) otherwise Ler("./" & DataFolder),
			    Tipos = Table.TransformColumnTypes(Fonte, {{"product_id", type text}, {"product_name", type text}, {"category", type text}}, "en-US")
			in
			    Tipos
